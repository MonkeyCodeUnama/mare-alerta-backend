# ========================================================
# Maré Alerta — Exemplo de Variáveis de Ambiente (.env)
# ========================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# cp .env.example .env

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=marealerta_dev
DB_URL=jdbc:postgresql://localhost:5432/marealerta_dev
DB_USER=postgres
DB_PASSWORD=password

# --- Segurança & JWT ---
# Em produção, gere uma chave forte (Base64 com 256 bits ou mais)
JWT_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Tempo de expiração do access token em milissegundos (ex: 900000 = 15min, 9000000 = 2h30min)
JWT_EXPIRATION=9000000
# Tempo de expiração do refresh token em milissegundos (ex: 604800000 = 7 dias)
JWT_REFRESH_EXPIRATION=604800000

# --- CORS (Cross-Origin Resource Sharing) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting (Bucket4j + Caffeine) ---
# Capacidade máxima de requisições por IP
RATE_LIMIT_CAPACITY=60
# Quantidade de tokens repostos no balde por período
RATE_LIMIT_REFILL_TOKENS=60
# Duração em segundos para recarga dos tokens (ex: 60 = 60 req/min)
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# --- Gateway de WhatsApp (Evolution API) ---
WHATSAPP_API_URL=http://localhost:8081
WHATSAPP_API_KEY=marealerta_secret_key_2026
WHATSAPP_INSTANCIA=marealerta_belem

# --- Serviço de Inteligência Artificial / Machine Learning (FastAPI) ---
IA_CHUVA_URL=http://127.0.0.1:8000/v1/predict
IA_BUILD_CONTEXT=../mare-alerta-ia

# --- Upload de Arquivos / Ocorrências ---
UPLOADS_OCORRENCIAS_DIR=/app/uploads/ocorrencias
