# ========================================================
# Maré Alerta — Exemplo de Variáveis de Ambiente (.env)
# ========================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# cp .env.example .env

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=marealerta_dev
DB_URL=jdbc:postgresql://localhost:5432/marealerta_dev
DB_USER=postgres
DB_PASSWORD=password

# --- Segurança & JWT ---
# Em produção, gere uma chave forte (Base64 com 256 bits ou mais)
JWT_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION=9000000

# --- Gateway de WhatsApp (Evolution API) ---
# Em produção, substitua por uma API key forte e secreta
EVOLUTION_API_KEY=marealerta_secret_key_2026
WHATSAPP_API_URL=http://localhost:8081
WHATSAPP_INSTANCIA=marealerta_belem

