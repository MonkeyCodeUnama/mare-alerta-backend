# Maré Alerta — variáveis para desenvolvimento/produção
# Copie para .env e substitua os valores de exemplo.

# PostgreSQL usado pelo Compose
POSTGRES_USER=marealerta
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=marealerta_prod
# Usado quando o backend roda fora do Compose; dentro do Compose, o arquivo define postgres como host.
DB_URL=jdbc:postgresql://localhost:5432/marealerta_prod
DB_USER=marealerta
DB_PASSWORD=troque-por-uma-senha-forte

# JWT — gere uma chave Base64 com pelo menos 256 bits.
JWT_KEY=gere-uma-chave-base64-forte
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS — inclua a origem exata da aplicação publicada na Vercel.
APP_CORS_ALLOWED_ORIGINS=https://seu-projeto.vercel.app,http://localhost:5173

# Rate limiting
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_TOKENS=60
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# Evolution API / WhatsApp
EVOLUTION_API_KEY=gere-uma-chave-forte
WHATSAPP_API_URL=http://evolution_api:8080
WHATSAPP_INSTANCIA=marealerta_belem

# Serviço de IA — quando backend e IA sobem no mesmo Compose.
IA_CHUVA_URL=http://weather-model:8000/v1/predict
IA_CHUVA_API_KEY=gere-uma-chave-forte-e-use-a-mesma-na-IA
